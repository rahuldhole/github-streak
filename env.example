# GitHub Personal Access Token (PAT)
# Required scopes: read:user
# Generate one at https://github.com/settings/tokens
#FAST_LANE_TTL_MINUTES=5
#SLOW_LANE_TTL_MINUTES=60

# GitHub Camo Cache Time-to-Live in seconds
# Controls how long GitHub caches the SVG (default is 120s from camo)
# Min: 0 (no cache), Max: typically up to 3600 depending on Camo's own limits
#CAMO_CACHE_TTL_SECONDS=120

GITHUB_TOKEN=your_github_token_here
GITHUB_TOKEN_SECONDARY=your_github_token_here